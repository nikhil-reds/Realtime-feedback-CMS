// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  DRAFT
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum VoteType {
  UP
  DOWN
}

model Session {
  id          String        @id @default(uuid())
  publicId    String        @unique // Short dynamic session identifier (e.g. "8FJ29K") for public URLs & QR codes
  name        String
  description String?
  speaker     String
  location    String
  status      SessionStatus @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  feedbacks   Feedback[]
  events      SessionEvent[]

  @@index([publicId])
  @@index([status])
}

model Feedback {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visitorId   String?  // Anonymous visitor/device identifier to prevent duplicate spam
  visitorCode String?  // Short human-readable code assigned to a visitor, retained via cookie
  vote        VoteType
  rating      Int?     // 1-7 PULSE scale rating; source of truth for the 7-category breakdown
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([sessionId, visitorCode])
}

model SessionEvent {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String   // e.g. SESSION_CREATED, SESSION_STARTED, QR_GENERATED, FEEDBACK_UP, FEEDBACK_DOWN, SESSION_COMPLETED
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
